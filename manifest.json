{
  "manifest_version": 3,
  "name": "Better X/Twitter",
  "version": "1.0.18",
  "description": "Hide promoted posts locally and clean up desktop X in fewer clicks",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://api.polar.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "close-mini-window": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Close X mini window"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better X/Twitter",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
